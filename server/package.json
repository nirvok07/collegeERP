{
  "name": "@college-erp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/infrastructure/db/migrate.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env src/infrastructure/db/bootstrap-cli.ts",
    "db:setup": "./scripts/setup-db.sh",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:device-test": "tsx --env-file-if-exists=.env scripts/seed-device-test.ts",
    "seed:college-tree": "tsx --env-file-if-exists=.env scripts/seed-college-tree.ts",
    "platform:break-glass": "tsx --env-file-if-exists=.env scripts/platform-break-glass.ts",
    "db:supabase:rebuild": "tsx --env-file-if-exists=.env scripts/supabase-dev-rebuild.ts",
    "platform:set-password": "tsx --env-file-if-exists=.env scripts/platform-set-password.ts",
    "platform:create-owner": "tsx --env-file-if-exists=.env scripts/platform-create-owner.ts",
    "platform:disable-account": "tsx --env-file-if-exists=.env scripts/platform-disable-account.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "13.5.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
