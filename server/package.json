{
  "name": "@college-erp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:bootstrap": "tsx src/infrastructure/db/bootstrap-cli.ts",
    "db:setup": "./scripts/setup-db.sh",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:device-test": "tsx scripts/seed-device-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
