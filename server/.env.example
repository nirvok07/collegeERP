# Copy to server/.env for local development. Never commit server/.env.
# OD-ENV-1: development uses local PostgreSQL college_erp_dev (npm run db:setup, then npm run migrate).
# The npm scripts load server/.env themselves (--env-file-if-exists); tests set their own values.

NODE_ENV=development
PORT=3000

# Application role and migrator role on the local development database.
DATABASE_URL=postgres://erp_app:erp_app_local@localhost:5432/college_erp_dev
MIGRATION_DATABASE_URL=postgres://erp_migrator:erp_migrator_local@localhost:5432/college_erp_dev
# An administrative connection, used once to provision the roles above.
BOOTSTRAP_DATABASE_URL=postgres://<your-admin-user>@localhost:5432/college_erp_dev

# At least 32 characters each; different from each other.
JWT_SECRET=<random, at least 32 characters>
COOKIE_SECRET=<random, at least 32 characters>

# AD-63: 32 bytes, base64. Generate with: openssl rand -base64 32. Required in production.
SECRET_SEALING_KEY=<openssl rand -base64 32>
SECRET_SEALING_KEY_ID=k1

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
