# Copy to server/.env for local development. Never commit server/.env.
# AD-68: development and app testing use Supabase PostgreSQL, as plain PostgreSQL through its
# session pooler; production runs the same Node server on our own PostgreSQL. No Supabase SDK.
# The npm scripts load server/.env themselves (--env-file-if-exists); `npm test` keeps its own
# local college_erp_test and ignores this file.

NODE_ENV=development
PORT=3000

# The two values Supabase provides (Project Settings -> Database). `npm run db:supabase:rebuild`
# derives the three connections below from them, provisions the roles, applies the migrations
# and rewrites the three keys.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_POOLER_DATABASE_URL=postgresql://erp_app.<project-ref>:<erp_app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Application role, migrator role, and an administrative connection used to provision roles.
DATABASE_URL=postgresql://erp_app.<project-ref>:<erp_app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=postgresql://erp_migrator.<project-ref>:<erp_migrator-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
BOOTSTRAP_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Local PostgreSQL alternative (npm run db:setup, then npm run migrate): swap these in.
LOCAL_DATABASE_URL=postgres://erp_app:erp_app_local@localhost:5432/college_erp_dev
LOCAL_MIGRATION_DATABASE_URL=postgres://erp_migrator:erp_migrator_local@localhost:5432/college_erp_dev
LOCAL_BOOTSTRAP_DATABASE_URL=postgres://<your-admin-user>@localhost:5432/college_erp_dev

# At least 32 characters each; different from each other.
JWT_SECRET=<random, at least 32 characters>
COOKIE_SECRET=<random, at least 32 characters>

# AD-63: 32 bytes, base64. Generate with: openssl rand -base64 32. Required in production.
SECRET_SEALING_KEY=<openssl rand -base64 32>
SECRET_SEALING_KEY_ID=k1

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
